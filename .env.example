DATABASE_URL=postgresql://username:password@localhost:5432/collaborative_task_manager
JWT_SECRET=your-super-secret-jwt-key-here
NODE_ENV=development
PORT=3000

# Comma-separated frontend origins allowed for CORS + Socket.io (production).
# Example: https://your-app.vercel.app
FRONTEND_URL=

# WebRTC TURN (required for reliable voice chat across networks).
# Free option: Metered.ca Open Relay — https://www.metered.ca/tools/openrelay/
TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayprojectsecret

# Optional: set to "relay" to force TURN-only testing
# ICE_TRANSPORT_POLICY=all
